{
  "name": "freelance-hunter-cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply freelance-hunter-db --local",
    "migrate:remote": "wrangler d1 migrations apply freelance-hunter-db --remote",
    "deploy": "wrangler deploy && npm run migrate:remote",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
