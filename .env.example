# App
APP_ENV=development
APP_NAME=Freelance Hunter AI
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (local Docker Compose defaults; change for shared environments)
DATABASE_URL=postgresql+psycopg://fhai:fhai_local_only@localhost:5432/fhai

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth: generate a unique random value before non-local use
JWT_SECRET=replace-with-a-long-random-secret-for-local-development-only
ACCESS_TOKEN_MINUTES=30

# Email provider is not configured in the scaffold.
# Set these only after choosing a provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Telegram
TELEGRAM_BOT_TOKEN=

# AI provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
