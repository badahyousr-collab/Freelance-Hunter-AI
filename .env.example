# Telegram
TELEGRAM_BOT_TOKEN=
BOT_API_SECRET=replace-with-a-long-random-secret-shared-by-api-and-bot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# AI provider
